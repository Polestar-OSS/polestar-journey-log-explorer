            { "id": "summer-mid-pm", "label": "Mid-peak", "rate": 0.157, "days": "weekday", "season": "summer", "from": "17:00", "to": "19:00" },
            { "id": "winter-on-am", "label": "On-peak", "rate": 0.203, "days": "weekday", "season": "winter", "from": "07:00", "to": "11:00" },
