{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polestar-oss.github.io/polestar-journey-log-explorer/tariff-provider.schema.json",
  "title": "Tariff provider preset",
  "description": "One electricity provider (or a generic region) and the price plans it offers. Every plan is a partial Tariff that is merged over the app defaults; see docs/TARIFF_PRESETS.md.",
  "type": "object",
  "required": [
    "id",
    "provider",
    "region",
    "plans"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable identifier, also the file name without .json"
    },
    "provider": {
      "type": "string",
      "description": "Who sells the electricity, or 'Generic' for a regional average"
    },
    "region": {
      "type": "string",
      "description": "Where the plans apply, e.g. 'Ottawa, Ontario, Canada'"
    },
    "currency": {
      "type": "string",
      "maxLength": 8,
      "description": "Display label only ('CAD', 'EUR', 'R$'); pricing never depends on it"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "Where the numbers come from"
    },
    "effective": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the rates took effect"
    },
    "notes": {
      "type": "string",
      "description": "Anything the model cannot express (holidays, delivery charges, rebates)"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tariff"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tariff": {
            "$ref": "#/$defs/tariff"
          },
          "fuel": {
            "$ref": "#/$defs/fuel",
            "description": "Overrides the provider-level fuel price for this plan (a province or state)"
          }
        }
      }
    },
    "fuel": {
      "$ref": "#/$defs/fuel"
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
    },
    "monthDay": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "tier": {
      "type": "object",
      "required": [
        "upToKwh",
        "rate"
      ],
      "properties": {
        "upToKwh": {
          "type": [
            "number",
            "null"
          ],
          "description": "Upper bound of the tier in kWh per month; null for the last, open-ended tier"
        },
        "rate": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tariff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "maxLength": 8
        },
        "mode": {
          "enum": [
            "flat",
            "tou",
            "tiered"
          ]
        },
        "seasons": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "from": {
                "$ref": "#/$defs/monthDay"
              },
              "to": {
                "$ref": "#/$defs/monthDay",
                "description": "Inclusive; a value before `from` wraps the year end"
              }
            }
          }
        },
        "flat": {
          "type": "object",
          "properties": {
            "rate": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "tou": {
          "type": "object",
          "properties": {
            "defaultRate": {
              "type": "number",
              "minimum": 0,
              "description": "Price when no period matches"
            },
            "periods": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "rate",
                  "from",
                  "to"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "rate": {
                    "type": "number",
                    "minimum": 0
                  },
                  "days": {
                    "enum": [
                      "all",
                      "weekday",
                      "weekend"
                    ]
                  },
                  "season": {
                    "type": "string",
                    "description": "A season id from `seasons`, or 'all'"
                  },
                  "from": {
                    "$ref": "#/$defs/time"
                  },
                  "to": {
                    "$ref": "#/$defs/time",
                    "description": "Exclusive; a value at or before `from` wraps midnight, equal means all day"
                  }
                }
              }
            }
          }
        },
        "tiered": {
          "type": "object",
          "properties": {
            "householdBaselineKwh": {
              "type": "number",
              "minimum": 0
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/tier"
              }
            },
            "tiersBySeason": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/tier"
                }
              }
            }
          }
        },
        "fixedMonthlyFee": {
          "type": "number",
          "minimum": 0
        },
        "publicCharging": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "sharePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "rate": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "chargingLossPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "homeCharger": {
          "type": "object",
          "properties": {
            "powerKw": {
              "type": "number"
            },
            "strategy": {
              "enum": [
                "plugin",
                "cheapest",
                "window"
              ]
            }
          }
        },
        "homeChargingWindow": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/time"
            },
            "to": {
              "$ref": "#/$defs/time"
            }
          }
        },
        "batteryUsableKwh": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "fuel": {
      "type": "object",
      "required": [
        "source",
        "effective"
      ],
      "additionalProperties": false,
      "properties": {
        "pricePerLitre": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pricePerGallon": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "US gallon"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "effective": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Regular petrol pump price with its source; fills the fuel price when the preset is chosen"
    }
  }
}
